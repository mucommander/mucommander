<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase-9 SpotBugs baseline.
  Each Match entry suppresses ONE (source-file, bug-pattern) pair
  that was already present when SpotBugs was first wired into CI.
  The build fails on any NEW (source, pattern) pair not listed here.
  
  To fix a finding: fix the code, then delete the corresponding line.
-->
<FindBugsFilter>

  <!-- Vendored upstream packages (Sun NFS, Sun GSS, sun.net.www) 
       — not ours to fix; suppress wholesale (33 findings). -->
  <Match><Package name="~com\.sun\.file.*"/></Match>
  <Match><Package name="~com\.sun\.gssapi.*"/></Match>
  <Match><Package name="~com\.sun\.nfs.*"/></Match>
  <Match><Package name="~com\.sun\.rpc.*"/></Match>
  <Match><Package name="~com\.sun\.xfile.*"/></Match>
  <Match><Package name="~com\.sun\.xfilechooser.*"/></Match>
  <Match><Package name="~com\.sun\.xhandler.*"/></Match>
  <Match><Package name="~sun\.net\.www.*"/></Match>

  <!-- Pre-existing (source, pattern) pairs in our own code. -->
  <Match><Class name="~dev\.barebones\.commander\.StressTester([\$.].*)?"/><Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/></Match>
  <!-- CredentialsMapping / Bookmark / FileComparator / BOM hashCode
       contracts fixed; entries retired. -->
